{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "outDir": "./.test-dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/types/**/*.ts",
    "src/constants/**/*.ts",
    "src/utils/**/*.ts",
    "src/api/**/*.ts",
    "src/hooks/**/*.ts",
    "src/context/**/*.tsx",
    "src/components/**/*.tsx",
    "src/locales/**/*.json",
    "src/__tests__/setup.ts",
    "src/__tests__/**/*.test.ts",
    "src/__tests__/**/*.test.tsx"
  ]
}
