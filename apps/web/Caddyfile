{
	admin off
}

{$SITE_ADDRESS::8421} {
	encode zstd gzip

	@vscode path /api/v1/vscode /api/v1/vscode/*
	respond @vscode "Use dedicated SANDBOX_ORIGIN port" 403

	@backend path /api/* /healthz /version /docs* /redoc* /openapi.json
	handle @backend {
		reverse_proxy {$API_UPSTREAM:api:8420}
	}

	@assets path /assets/*
	handle @assets {
		root * /app/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /app/web
		header Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

{$SANDBOX_SITE_ADDRESS::8423} {
	encode zstd gzip

	@vscode path /api/v1/vscode/*
	handle @vscode {
		reverse_proxy {$API_UPSTREAM:api:8420} {
			header_up -Cookie
		}
	}

	handle {
		respond "Not Found" 404
	}
}
