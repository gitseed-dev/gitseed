# ------------------------------------------------------------------------------
# GitSeed Environment Configuration
# IMPORTANT: Do NOT copy .env.example directly without running secret generation!
# Always run `make init`, `./scripts/init.sh`, or `.\scripts\init.ps1` so strong
# cryptographic secrets replace the development placeholders below (the API fails
# closed on startup if placeholder secrets remain).
# ------------------------------------------------------------------------------

# Application
GITSEED_VERSION=dev
ENVIRONMENT=development
DEBUG=false
GITSEED_AUTO_MIGRATE=true

# Bootstrap Admin & Session Auth
GITSEED_ADMIN_EMAIL=admin@gitseed.local
GITSEED_ADMIN_NAME=Admin
GITSEED_ADMIN_PASSWORD=gitseed_admin
GITSEED_SECRET_KEY=gitseed-dev-secret-key-change-in-production
SESSION_COOKIE_NAME=gitseed_session
SESSION_TTL_SECONDS=604800

# Network & Ports
# Note: To expose GitSeed on a LAN IP (e.g. 192.168.1.50), update BIND_HOST,
# PUBLIC_WEB_URL, CORS_ORIGINS, and SANDBOX_ORIGIN together.
HOST=0.0.0.0
BIND_HOST=127.0.0.1
MCP_BIND_HOST=127.0.0.1
API_PORT=8420
WEB_PORT=8421
MCP_PORT=8422
SANDBOX_PORT=8423
SANDBOX_ORIGIN=http://127.0.0.1:8423
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-gitseed-litellm-master-key
LITELLM_SALT_KEY=sk-gitseed-litellm-salt-key
PUBLIC_WEB_URL=http://localhost:8421
CORS_ORIGINS=http://localhost:8421,http://127.0.0.1:8421
LOCAL_WORKSPACES_HOST_DIR=./data/workspaces
LOCAL_WORKSPACE_ROOTS=/workspaces
INCLUDE_PROPRIETARY_CLIS=true
GITSEED_ALLOW_PERSONAL_CLI_OAUTH=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_USER=gitseed
POSTGRES_PASSWORD=gitseed_password
POSTGRES_DB=gitseed
POSTGRES_PORT=5432

# Valkey (Redis-compatible, BSD-3-Clause)
VALKEY_PORT=6379
VALKEY_PASSWORD=gitseed_valkey_password
REDIS_URL=redis://:gitseed_valkey_password@valkey:6379/0

# Bootstrap Compute Backend & Kubernetes Runtime
# Provider to pre-seed on initial bootstrap: "auto" | "docker" | "kubernetes" | "none"
GITSEED_BOOTSTRAP_COMPUTE_PROVIDER=auto
K8S_API_URL=https://kubernetes.default.svc
RUNNER_K8S_NAMESPACE=
SANDBOX_K8S_NAMESPACE=
# Namespace isolation mode for Kubernetes: "workload" | "project" | "shared"
K8S_NAMESPACE_ISOLATION=workload
RUNNER_K8S_SERVICE_ACCOUNT=
